{
  "mcpServers": {
    "resolve": {
      "command": "npx",
      "args": ["-y", "-p", "github:TANISHQBAFNA/resolve#v0.1.1", "resolve-mcp"],
      "env": {
        "FIGMA_ACCESS_TOKEN": "${FIGMA_ACCESS_TOKEN}",
        "RESOLVE_LIBRARY_FILE_KEY": "${RESOLVE_LIBRARY_FILE_KEY}",
        "RESOLVE_MODE": "${RESOLVE_MODE}",
        "RESOLVE_REPO_PATH": "${RESOLVE_REPO_PATH}",
        "RESOLVE_CSS_ENTRY": "${RESOLVE_CSS_ENTRY}",
        "RESOLVE_THEME": "${RESOLVE_THEME}"
      }
    }
  }
}
