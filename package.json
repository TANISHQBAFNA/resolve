{
  "name": "resolve-figma",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Resolve — Figma rules. Agents resolve. One-node Figma component usage map for Cursor agents.",
  "bin": {
    "resolve": "./bin/resolve-cli.mjs",
    "resolve-mcp": "./bin/resolve-mcp.mjs",
    "resolve-figma": "./bin/resolve-cli.mjs",
    "resolve-setup": "./bin/resolve-setup.mjs"
  },
  "files": [
    "bin",
    "commands",
    "dist-server",
    "docs",
    "rules",
    "skills/resolve",
    "README.md",
    "AGENTS.md",
    "INSTALL-FOR-AI.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && vite build --config vite.server.config.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bench": "vitest run --config vitest.bench.config.ts --reporter=verbose",
    "test:e2e": "playwright test",
    "test:all": "vitest run && playwright test",
    "test:watch": "vitest",
    "build:server": "vite build --config vite.server.config.ts",
    "prepare": "vite build --config vite.server.config.ts",
    "resolve": "node dist-server/cli.mjs",
    "mcp": "node dist-server/mcp.mjs",
    "keyline": "node dist-server/cli.mjs"
  },
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "~5.9.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "license": "MIT"
}
