{
  "name": "resolve-figma",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Resolve tells Claude Code and Cursor which real Figma components to use, then checks the screen. Works with any design system and any code stack.",
  "keywords": [
    "figma",
    "design-system",
    "components",
    "claude-code",
    "cursor",
    "mcp"
  ],
  "bin": {
    "resolve": "./bin/resolve-cli.mjs",
    "resolve-mcp": "./bin/resolve-mcp.mjs",
    "resolve-figma": "./bin/resolve-cli.mjs",
    "resolve-setup": "./bin/resolve-setup.mjs"
  },
  "files": [
    "bin",
    "commands",
    "dist-server",
    "docs",
    "schemas",
    "rules",
    "skills/resolve",
    "hooks",
    "scripts",
    ".claude-plugin",
    ".cursor-plugin",
    ".mcp.json",
    "mcp.json",
    "README.md",
    "AGENTS.md",
    "INSTALL-FOR-AI.md"
  ],
  "scripts": {
    "dev": "vite",
    "build:browser": "vite build",
    "build:server": "vite build --config vite.server.config.ts",
    "build": "tsc --noEmit && npm run build:browser && npm run build:server",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:size": "node scripts/check-file-length.mjs",
    "check:meaning": "node scripts/meaning-regression.mjs check",
    "check:dupes": "jscpd src --pattern \"**/*.ts\" --min-lines 5 --min-tokens 40 --threshold 0.75 --reporters console",
    "bench": "vitest run --config vitest.bench.config.ts --reporter=verbose",
    "test:e2e": "playwright test",
    "test:all": "vitest run && playwright test",
    "test:watch": "vitest",
    "prepare": "node scripts/prepare-server.mjs",
    "resolve": "node dist-server/cli.mjs",
    "mcp": "node dist-server/mcp.mjs",
    "keyline": "node dist-server/cli.mjs"
  },
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "~5.9.3",
    "zod": "^3.25.76",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@angular/cdk": "22.2.3",
    "@angular/material": "22.2.3",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "jscpd": "^4.0.5",
    "vite": "^8.3.5",
    "vite-node": "6.0.0",
    "vitest": "^5.0.1"
  },
  "license": "SEE LICENSE IN LICENSE"
}
