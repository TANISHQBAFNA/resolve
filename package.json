{
  "name": "resolve-figma",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Resolve tells Claude Code and Cursor which real components to use, Figma masters or coded HTML/CSS classes, then checks the result. Works with any design system and any code stack.",
  "keywords": [
    "figma",
    "design-system",
    "components",
    "claude-code",
    "cursor",
    "html",
    "mcp"
  ],
  "bin": {
    "resolve": "./bin/resolve-cli.mjs",
    "resolve-mcp": "./bin/resolve-mcp.mjs",
    "resolve-figma": "./bin/resolve-cli.mjs",
    "resolve-setup": "./bin/resolve-setup.mjs"
  },
  "files": [
    "bin",
    "commands",
    "legacy",
    "dist-server",
    "docs",
    "templates",
    "examples",
    "schemas",
    "rules",
    "skills",
    "hooks",
    "scripts",
    ".claude-plugin",
    ".cursor-plugin",
    ".mcp.json",
    "mcp.json",
    "README.md",
    "AGENTS.md",
    "INSTALL-FOR-AI.md"
  ],
  "scripts": {
    "dev": "vite",
    "build:browser": "vite build",
    "build:server": "vite build --config vite.server.config.ts",
    "build": "tsc --noEmit && npm run build:browser && npm run build:server",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "prepare": "node scripts/prepare-server.mjs",
    "resolve": "node dist-server/cli.mjs",
    "mcp": "node dist-server/mcp.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "~5.9.3",
    "zod": "^4.6.6",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "vite": "^8.3.5"
  },
  "license": "MIT"
}
