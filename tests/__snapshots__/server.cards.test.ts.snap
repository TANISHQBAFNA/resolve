    slots:
      - role: body | required: true | status: unbound | nextRecommend: card
      - role: primary-cta | required: true | status: filled | master: (name: Button, figmaNodeId: 30:10, fileKey: ACMEUI)
      - role: secondary-cta | status: filled | master: (name: Button, figmaNodeId: 30:10, fileKey: ACMEUI)
  -
    id: empty-state
    title: Empty state
