{
  "mcpServers": {
    "resolve": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "-p", "github:TANISHQBAFNA/resolve#v0.1.0", "resolve-mcp"],
      "env": {
        "FIGMA_ACCESS_TOKEN": "${user_config.FIGMA_ACCESS_TOKEN}",
        "RESOLVE_LIBRARY_FILE_KEY": "${user_config.RESOLVE_LIBRARY_FILE_KEY}"
      }
    }
  }
}
